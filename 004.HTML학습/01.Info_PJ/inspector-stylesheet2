.work {background-image: linear-gradient(45deg , #ffcccc 23%, #99dfeb, #99d);padding: 10px 46px 20px;text-align: center;}

.work h4 {
    /* font-family: "Asta Sans", sans-serif; */
    font-family: "Do Hyeon", sans-serif;
    font-size: 31px;
    font-weight: normal;
    margin-bottom: 19px;
    color: #f8bb9f;
    -webkit-text-stroke: 0.75px #757575;
}

.work img {
    border: 20px ridge palegoldenrod;
    max-width: 100%;
}

figure {}

.work figcaption {
    font-family: "Do Hyeon", sans-serif;
    font-weight: normal;
    color: purple;
    font-size: 20px;
    margin-top: 10px;
}

.work figcaption cite {
    font-style: normal;
    color: navy;
}